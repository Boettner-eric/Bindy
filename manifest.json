{
  "name": "Bindy",
  "description": "Define custom keyboard shortcuts for any site",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "js": [
        "scripts/storage.js",
        "scripts/hotkey.js",
        "scripts/selector.js",
        "scripts/iframe.js",
        "scripts/bar.js",
        "scripts/themes.js",
        "scripts/modal.js",
        "scripts/actions.js",
        "scripts/page.js"
      ],
      "css": ["styles.css"],
      "matches": ["<all_urls>"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "/icons/16x16.png",
    "32": "/icons/32x32.png",
    "48": "/icons/48x48.png",
    "128": "/icons/128x128.png",
    "256": "/icons/256x256.png",
    "512": "/icons/512x512.png"
  },
  "options_page": "settings.html",
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["fonts/FiraCode-Regular.woff2", "settings.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
